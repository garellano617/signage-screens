<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Everything the viewer sees. Rotated in software for portrait screens. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#000000">

        <!-- Layer 1, video: the playlist. PlaybackEngine adds its views here; sized to the chosen area. -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- Layers 2-4, specials / text / effects: a transparent web page on top (see Overlay.kt). -->
        <FrameLayout
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Pairing screen: a Premier Signage advert on top (white, logo + name), the pairing code below. -->
    <LinearLayout
        android:id="@+id/pairing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0f172a"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#ffffff"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingTop="20dp"
            android:paddingRight="32dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:maxHeight="260dp"
                android:scaleType="fitCenter"
                android:src="@drawable/premier_logo" />

            <TextView
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/brand_name"
                android:textColor="#1a72b4"
                android:textSize="56sp"
                android:textStyle="bold"
                tools:targetApi="o" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/brand_tagline"
                android:textColor="#475569"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingTop="16dp"
            android:paddingRight="32dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pair_title"
                android:textColor="#cbd5e1"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/pairCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:textColor="#ffffff"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pairHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#94a3b8"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0f172a"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="#ffffff"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/setup_hint"
            android:textColor="#94a3b8"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1e293b"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:hint="@string/setup_example"
            android:textColorHint="#64748b" />

        <Button
            android:id="@+id/serverSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_save"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/setupError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#fca5a5"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="24dp"
        android:background="#cc111827"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/identifyText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#e62563eb"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#ffffff"
        android:textSize="72sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
