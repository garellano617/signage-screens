<?xml version="1.0" encoding="utf-8"?>
<!-- Portals on a local network usually run on plain http://, so allow it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
